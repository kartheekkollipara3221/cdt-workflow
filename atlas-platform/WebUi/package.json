{
  "name": "web-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "start:target-look": "node ../local/make-target-look.mjs && ng serve --configuration target-look",
    "check:target-flags": "tsc -p tsconfig.target-flags.json"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/animations": "^21.2.25",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@maskito/angular": "^3.11.1",
    "@maskito/core": "^3.11.1",
    "@maskito/kit": "^3.11.1",
    "@ng-select/ng-select": "^21.8.2",
    "@primeng/themes": "^21.0.4",
    "ag-grid-angular": "~33.1.0",
    "ag-grid-community": "~33.1.0",
    "bootstrap": "^5.3.8",
    "ngx-toastr": "^20.0.4",
    "primeng": "^21.0.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@fontsource/cormorant-infant": "^5.3.0",
    "@fontsource/mulish": "^5.3.0",
    "@types/uuid": "^9.0.8",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
