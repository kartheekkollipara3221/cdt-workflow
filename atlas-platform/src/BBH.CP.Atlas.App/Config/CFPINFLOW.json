{
  // ClientInflows form (module 25, 5.2). People are LAN IDs. Part 1 = the inflow, part 2 = the cash receipt.
  // The account list comes from AIN.AccountInventory. The account fills 4 fields and RMCC (a column with no control).
  // The state of the record (WorkflowState) drives the rules: part 2 is hidden in Draft, part 1 is read-only after
  // Draft, and part 2 is read-only after Submitted. One submit button: the server takes the step of the stored state
  // (Workflow.Steps). The files of FlowAttachments and CashAttachments are in CFP.InflowAttachment (Type = control name).
  // Description and Comment are rich text: the server cleans the HTML, and the History shows plain text.
  // Each submit runs the engine actions of the step (workflow ClientInflow, script 150). The list addresses are in
  // AppSettings:Modules:CFPINFLOW:Workflow:Lists of each environment.
  "Name": "Client Flows Portal - Inflow",
  "Type": "SECTION",
  "Rules": [
    { "Roles": [ "@Read" ], "Disabled": true },
    { "Roles": [ "Write" ], "Disabled": false }
  ],
  "Permissions": {
    "View": [ "@Read" ],
    "Create": [ "Write" ],
    "Edit": { "All": [ "Write" ] },
    "Delete": [ "Write" ],
    "History": [ "@Read" ]
  },
  "Defaults": {
    "FlowSubmittedBy": "{User.LanID}"
  },
  "SoftDelete": { "Field": "IsDeleted" },
  "HeaderNameWithId": "{Name} - {ID}",
  "Section": {
    "Name": "Client Flows Portal - Inflow",
    "Description": "",
    "HeaderName": "Client Flows Portal - Inflow",
    "Workflow": {
      "Key": "ClientInflow",
      "Roles": [],
      "Actions": {},
      "StateField": "WorkflowState",
      "StatusField": "Status",
      "InitialState": "Draft",
      "StatusLabels": { "Draft": "Draft", "Submitted": "Submitted", "FundsReceived": "Funds Received" },
      "BusinessObjectPrefix": "CFP-INFLOW-",
      "ActorRoles": "User",
      "Steps": {
        "Draft": {
          "EngineActions": [
            { "Start": "Submit", "Recipients": [ "icg" ] },
            { "Execute": "NotifyInformational", "Recipients": [ "investmentLists", "relationshipManager" ] }
          ]
        },
        "Submitted": {
          "Set": { "CashSubmittedBy": "{User.LanID}", "CashSubmittedDate": "{Now}" },
          "EngineActions": [
            { "Execute": "ConfirmFunds", "Recipients": [ "investmentLists", "relationshipManager", "csTeam", "rmcc", "imrg", "starFasIfiCash" ] }
          ]
        }
      },
      "Recipients": {
        "icg": { "List": "Icg" },
        "csTeam": { "List": "CsTeam" },
        "imrg": { "List": "Imrg" },
        "starFasIfiCash": { "List": "StarFasIfiCash" },
        "investmentLists": {
          "ListByField": "InvestmentType",
          "Map": {
            "Fixed Income": [ "FixedIncome" ],
            "Equity": [ "Equity" ],
            "Fixed Income & Equity": [ "FixedIncome", "Equity" ]
          }
        },
        "relationshipManager": { "FromNameField": "RelationshipManager", "Optional": true },
        "rmcc": { "FromNameField": "RMCC", "Optional": true }
      },
      "TemplateData": {
        "accountName": { "Field": "AccountName" },
        "accountNumber": { "Field": "AccountNumber" },
        "amount": { "Field": "Amount", "Format": "$#,##0.00" },
        "inflowDate": { "Field": "InflowDate", "Format": "MM/dd/yyyy" },
        "recordLink": { "RecordLink": true }
      }
    },
    "Controls": [
      {
        "Name": "InflowAccount",
        "Label": "Account Details",
        "Type": "section",
        "PlaceHolder": "",
        "Class": "grid grid-cols-3 gap-6 items-start p-8 bg-white",
        "Rules": [ { "Roles": [ "Write" ], "States": [ "Draft" ], "Disabled": false } ],
        "ChildControls": [
          {
            "Name": "AccountNumber",
            "Field": "AccountNumber",
            "Label": "Account",
            "Type": "ngselect",
            "Multiple": false,
            "PlaceHolder": "Account",
            "OptionsSource": {
              "Provider": "Table",
              "Parameters": {
                "Table": "AIN.AccountInventory",
                "Value": "AccountNumber",
                "Label": "{AccountNumber} - {AccountName}",
                "Data": "AccountName,StarAccountNumber,RelationshipManager,Custodian,RMCC",
                "OrderBy": "AccountNumber",
                "UserNameColumns": "RelationshipManager,RMCC"
              }
            },
            "KeepSavedValue": true,
            "Effects": [
              {
                "When": { "HasValue": true },
                "SetFromOption": {
                  "AccountName": "AccountName",
                  "StarNumber": "StarAccountNumber",
                  "RelationshipManager": "RelationshipManager",
                  "Custodian": "Custodian",
                  "RMCC": "RMCC"
                }
              },
              {
                "When": { "HasValue": false },
                "Clear": [ "AccountName", "StarNumber", "RelationshipManager", "Custodian" ]
              }
            ],
            "Validator": { "Required": true }
          },
          { "Name": "AccountName", "Field": "AccountName", "Label": "Account Name", "Type": "text", "PlaceHolder": "Account Name", "Disabled": true },
          { "Name": "StarNumber", "Field": "StarNumber", "Label": "STAR Number", "Type": "text", "PlaceHolder": "STAR Number", "Disabled": true },
          { "Name": "RelationshipManager", "Field": "RelationshipManager", "Label": "Relationship Manager", "Type": "text", "PlaceHolder": "Relationship Manager", "Disabled": true },
          { "Name": "Custodian", "Field": "Custodian", "Label": "Custodian", "Type": "text", "PlaceHolder": "Custodian", "Disabled": true }
        ]
      },
      {
        "Name": "InflowDetails",
        "Label": "Inflow Details",
        "Type": "section",
        "PlaceHolder": "",
        "Class": "grid grid-cols-3 gap-6 items-start p-8 bg-white",
        "Rules": [ { "Roles": [ "Write" ], "States": [ "Draft" ], "Disabled": false } ],
        "ChildControls": [
          {
            "Name": "InvestmentType",
            "Field": "InvestmentType",
            "Label": "Investment Type",
            "Type": "select",
            "PlaceHolder": "Investment Type",
            "Options": [
              { "Label": "Fixed Income", "Value": "Fixed Income" },
              { "Label": "Equity", "Value": "Equity" },
              { "Label": "Fixed Income & Equity", "Value": "Fixed Income & Equity" }
            ],
            "Validator": { "Required": true }
          },
          { "Name": "Amount", "Field": "Amount", "Label": "Amount (USD)", "Type": "currency", "PlaceHolder": "Amount", "Validator": { "Required": true, "Min": 0.01 } },
          { "Name": "InflowDate", "Field": "InflowDate", "Label": "Inflow Date", "Type": "date", "PlaceHolder": "Inflow Date", "Validator": { "Required": true } },
          { "Name": "Description", "Field": "Description", "Label": "Description", "Type": "richtext", "PlaceHolder": "Description", "DivClass": "grid-column-start-end-1-2" },
          {
            "Name": "FlowAttachments",
            "Label": "Please attach email/signed instruction from the client.",
            "Type": "filepicker",
            "Multiple": true,
            "DivClass": "col-span-3",
            "Validator": { "Required": true }
          },
          { "Name": "FlowSubmittedBy", "Field": "FlowSubmittedBy", "Label": "Submitted By", "Type": "user", "PlaceHolder": "Submitted By", "Disabled": true },
          { "Name": "FlowConfirm", "Field": "FlowConfirm", "Label": "I confirm that the information above is correct.", "Type": "checkbox", "Validator": { "MustBeTrue": true } }
        ]
      },
      {
        "Name": "CashReceipt",
        "Label": "Cash Receipt Confirmation",
        "Type": "section",
        "PlaceHolder": "",
        "Class": "grid grid-cols-3 gap-6 items-start p-8 bg-white",
        "Rules": [
          { "States": [ "Draft" ], "Visible": false, "Disabled": true },
          { "Roles": [ "Write" ], "States": [ "Submitted" ], "Disabled": false }
        ],
        "ChildControls": [
          { "Name": "FundsReceived", "Field": "FundsReceived", "Label": "Funds have been received", "Type": "checkbox", "Validator": { "MustBeTrue": true } },
          { "Name": "Comment", "Field": "Comment", "Label": "Comment", "Type": "richtext", "PlaceHolder": "Comment", "DivClass": "grid-column-start-end-1-2" },
          {
            "Name": "CashAttachments",
            "Label": "Please attach proof of custodian receipt.",
            "Type": "filepicker",
            "Multiple": true,
            "DivClass": "col-span-3",
            "Validator": { "Required": true }
          },
          { "Name": "CashSubmittedBy", "Field": "CashSubmittedBy", "Label": "Confirmed By", "Type": "user", "PlaceHolder": "Confirmed By", "Disabled": true },
          { "Name": "CashConfirm", "Field": "CashConfirm", "Label": "I confirm that the funds have been received.", "Type": "checkbox", "Validator": { "MustBeTrue": true } }
        ]
      }
    ],
    "Buttons": [
      {
        "Name": "Submit",
        "Label": "Submit",
        "Visible": true,
        "Disabled": false,
        "Action": { "Type": "Save" },
        "Rules": [ { "Roles": [ "Write" ] } ]
      },
      {
        "Name": "Close",
        "Label": "Close",
        "Visible": true,
        "Disabled": false,
        "Action": { "Type": "Close" }
      }
    ]
  }
}
