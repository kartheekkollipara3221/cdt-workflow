{
  // ClientInflows manifest (module 25, 5.1). Environment overrides: AppSettings:Modules:CFPINFLOW:*.
  // LookupTables: the account list (Table option provider) reads AIN.AccountInventory. The platform never writes it.
  // AttachmentTable: the files of the two file pickers. Type holds the control name, InflowId the record ID.
  "Code": "CFPINFLOW",
  "Name": "Client Flows Portal - Inflow",
  "FormType": "FORM",
  "Parent": null,
  "Form": "CFPINFLOW.json",
  "Dashboard": "CFPINFLOW.Dashboard.json",
  "Table": "CFP.Inflow",
  "AuditTable": "CFP.AuditLog",
  "AttachmentTable": "CFP.InflowAttachment",
  "AttachmentColumns": { "RecordId": "InflowId", "ControlName": "Type" },
  "LookupTables": [ "AIN.AccountInventory" ],
  "Service": null,
  "AccessMode": "Enforce",
  "AuditMode": "Server",
  "AuditTime": "Utc",
  "RuleMode": "MostPermissive",
  "RuleDefault": "ReadOnly",
  "Enabled": true
}
