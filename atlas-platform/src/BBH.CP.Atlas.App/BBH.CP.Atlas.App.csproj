<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Local copy of the target project BBH.CP.Atlas.App (local demo host).
       Copy to the target: Platform/ and Config/TTDV2.*.json and Config/CFPINFLOW.*.json. Do not copy StandIn/, appsettings*.json or this file. -->
  <PropertyGroup>
    <RootNamespace>BBH.CP.Atlas.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\BBH.CP.Atlas.Infra\BBH.CP.Atlas.Infra.csproj" />
    <ProjectReference Include="..\BBH.CP.Atlas.Data\BBH.CP.Atlas.Data.csproj" />
    <ProjectReference Include="..\BBH.CP.Atlas.Service\BBH.CP.Atlas.Service.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Swashbuckle: the same version as the target. Negotiate: local Windows authentication on Kestrel (stand-in host only;
         the target uses IIS Windows authentication). -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="Config\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
