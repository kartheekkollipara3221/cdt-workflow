{
  "ConnectionStrings": {
    "DBConnection": "Server=localhost;Database=CPAtlasPlatformDev;Integrated Security=true;TrustServerCertificate=True;Encrypt=False",
    // The workflow engine tables are in the same local database (setup-local-db.ps1).
    "DefaultConnection": "Server=localhost;Database=CPAtlasPlatformDev;Integrated Security=true;TrustServerCertificate=True;Encrypt=False"
  },
  // Local emails go to smtp4dev (localhost:25). Without smtp4dev, set "Sender": "Console".
  "Notifications": { "Sender": "Smtp" },
  "Smtp": { "Host": "localhost", "Port": 25, "From": "cp-atlas-local@example.com" },
  "AppSettings": {
    "HostedClientURL": "http://localhost:4200",
    "Modules": {
      "TTDV2": { "Enabled": true, "AccessMode": "LogOnly" },
      // Placeholder addresses (local only). Each environment has the real distribution lists.
      "CFPINFLOW": {
        "Workflow": {
          "Lists": {
            "Icg": "icg-inflow@example.com",
            "CsTeam": "cs-team@example.com",
            "Imrg": "imrg@example.com",
            "StarFasIfiCash": "star-fas-ifi-cash@example.com",
            "FixedIncome": "fixed-income-pm@example.com",
            "Equity": "equity-pm@example.com"
          }
        }
      }
    }
  },
  "StandIn": {
    // "Fixed" (the Windows login of the API process) or "Negotiate" (Windows authentication in the browser).
    "Authentication": "Fixed",
    // Development only: the UI can send X-Atlas-Act-As with one of the users below (spec 12, 11.3).
    "ActAs": { "Enabled": true },
    "Users": {
      "ttd.read": { "DisplayName": "Riley Reader", "Note": "TTDV2 role Read" },
      "ttd.prep": { "DisplayName": "Pat Preparer", "Note": "TTDV2 role Prepare" },
      "ttd.prep2": { "DisplayName": "Quinn Preparer", "Note": "TTDV2 role Prepare" },
      "ttd.owner": { "DisplayName": "Olive Owner", "Note": "TTDV2 role Owner" },
      "ttd.none": { "DisplayName": "Nora Norole", "Note": "no TTDV2 role" }
    }
  }
}
