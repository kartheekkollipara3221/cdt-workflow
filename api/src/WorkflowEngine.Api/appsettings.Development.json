{
  "ConnectionStrings": {
    "DefaultConnection": "Server=DOLLY;Database=burrito;Integrated Security=true;TrustServerCertificate=True;Encrypt=False"
  },
  "Notifications": {
    "Sender": "Console"
  },
  "WorkflowApi": {
    "AllowDevelopmentHeaderActorResolver": true,
    "DisablePublicReset": true,
    "DisablePublicAdminOverride": true
  },
  "WorkflowDatabaseStartup": {
    "ApplyMigrationsAndSeedOnStartup": false,
    "VerifySeedOnStartup": false,
    "FailStartupWhenSeedVerificationFails": true
  }
}
