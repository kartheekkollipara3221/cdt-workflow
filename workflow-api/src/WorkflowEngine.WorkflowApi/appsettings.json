{
  "ConnectionStrings": {
    "DefaultConnection": "Server=DOLLY;Database=workflowengine;Integrated Security=true;TrustServerCertificate=True;Encrypt=False"
  },
  "Cors": {
    "Origins": [
      "http://localhost:4200"
    ]
  },
  "Notifications": {
    "Sender": "NoOp"
  },
  "WorkflowApi": {
    "ActorHeaders": {
      "UserIdHeaderName": "X-Workflow-UserId",
      "RolesHeaderName": "X-Workflow-Roles",
      "DisplayNameHeaderName": "X-Workflow-DisplayName"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
