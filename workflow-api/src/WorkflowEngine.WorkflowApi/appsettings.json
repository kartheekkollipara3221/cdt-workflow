{
  "Notifications": {
    "Sender": "NoOp"
  },
  "WorkflowApi": {
    "ActorHeaders": {
      "UserIdHeaderName": "X-Workflow-UserId",
      "RolesHeaderName": "X-Workflow-Roles",
      "DisplayNameHeaderName": "X-Workflow-DisplayName"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
